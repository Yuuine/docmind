# ===========================================
# Vector Service - 环境变量配置
# ===========================================

# 服务配置
# 服务监听端口（默认8001，避免与ChromaDB 8000冲突）
SERVICE_PORT=8001
# 服务监听地址
SERVICE_HOST=0.0.0.0

# ChromaDB 配置
# ChromaDB 持久化存储路径
CHROMA_PERSIST_PATH=./data/chroma_db
# ChromaDB Collection 名称
CHROMA_COLLECTION_NAME=docmind_chunks

# ===========================================
# Embedding 模型配置
# ===========================================

# Sentence-Transformers 模型名称
# 常用模型：
#   - paraphrase-multilingual-MiniLM-L12-v2 (多语言，384维，推荐)
#   - all-MiniLM-L6-v2 (英文，384维，速度快)
#   - paraphrase-multilingual-mpnet-base-v2 (多语言，768维，精度更高)
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2

# 推理设备配置
# 可选值：
#   - cpu: 强制使用 CPU（默认）
#   - cuda: 使用 NVIDIA GPU（需要安装 PyTorch CUDA 版本）
#   - auto: 自动检测，有 GPU 则使用 GPU，否则使用 CPU
#
# 注意：使用 CUDA 需要满足以下条件：
#   1. NVIDIA GPU 显卡
#   2. 安装了 NVIDIA CUDA 驱动
#   3. 安装了支持 CUDA 的 PyTorch 版本：
#      pip install torch torchvision --index-url https://download.pytorch.org/whl/cu121
#
# 性能对比（以 paraphrase-multilingual-MiniLM-L12-v2 为例）：
#   - CPU (i7-12700): ~100-200 文本/秒
#   - GPU (RTX 3080): ~1000-2000 文本/秒
EMBEDDING_DEVICE=cpu

# ===========================================
# 日志配置
# ===========================================

# 日志级别：DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ===========================================
# 混合检索配置 (Hybrid Search)
# ===========================================

# 是否启用混合检索（向量检索 + BM25 + RRF融合）
# 可选值：true, false (默认: false)
HYBRID_SEARCH_ENABLED=false

# 混合检索参数
# 向量检索返回的条数
HYBRID_VECTOR_TOP_K=10
# BM25 检索返回的条数
HYBRID_BM25_TOP_K=10
# RRF 融合参数 k (推荐范围: 30-100, 默认: 60)
# k 越小，排名前列的结果权重越高
HYBRID_RRF_K=60

# BM25 算法参数
# k1: 词频饱和度参数 (推荐范围: 1.2-2.0, 默认: 1.5)
#   - 较大的 k1 值会增加高频词的影响
#   - 较小的 k1 值会使词频影响更快饱和
BM25_K1=1.5
# b: 文档长度归一化参数 (推荐范围: 0.5-0.9, 默认: 0.75)
#   - b=0 时不进行长度归一化
#   - b=1 时完全按文档长度归一化
BM25_B=0.75
# 分词模式: jieba (中文), whitespace (英文)
BM25_TOKENIZE=jieba
